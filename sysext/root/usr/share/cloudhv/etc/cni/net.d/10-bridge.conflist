{
  "_comment": "SAMPLE FOR TESTS AND THE DEMO ONLY. A plain bridge with masquerading: pods on it can reach each other, the node and its other networks, and nothing isolates one pod from another. Do not use it for pods of different tenants; use a CNI with network policy (Cilium, ...).",
  "cniVersion": "1.0.0",
  "name": "bridge",
  "plugins": [
    {
      "type": "bridge",
      "bridge": "cni0",
      "isGateway": true,
      "ipMasq": true,
      "ipam": {
        "type": "host-local",
        "ranges": [[{"subnet": "10.88.0.0/16"}]],
        "routes": [{"dst": "0.0.0.0/0"}]
      }
    },
    { "type": "portmap", "capabilities": {"portMappings": true} },
    { "type": "loopback" }
  ]
}
